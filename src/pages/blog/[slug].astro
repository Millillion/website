---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const episodes = await getCollection("podcast", (e) => e.data.blog === post.id && !e.data.draft);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="prose">
    <h1>{post.data.title}</h1>
    <p class="muted">{post.data.date.toLocaleDateString("en-US", { dateStyle: "long" })}</p>
    {post.data.adaptedFrom && (
      <p class="ai-note">By Jordan Last, with AI. Written by AI from my own words in <a href={post.data.adaptedFrom.href}>{post.data.adaptedFrom.label}</a>.</p>
    )}
    {episodes[0] && !post.data.adaptedFrom && <p><a href={`/podcast/${episodes[0].id}/`}>Listen to this as an episode →</a></p>}
    <Content />
    {post.data.adaptedFrom && <p class="signoff">— By Jordan Last, with AI</p>}
  </article>
  <div class="box"><a class="cta primary" href="/support/">Support Millillion</a><a class="cta" href="/rss.xml">RSS</a></div>
</Base>
