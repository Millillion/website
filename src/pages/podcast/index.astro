---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { PODCAST } from "../../site.js";
const eps = (await getCollection("podcast", (p) => !p.data.draft)).sort((a, b) => b.data.date - a.data.date);
---
<Base title="Podcast" description={PODCAST.description}>
  <h1>Podcast</h1>
  <p>{PODCAST.description}</p>
  <p>
    {PODCAST.spotify && <a class="cta" href={PODCAST.spotify}>Spotify</a>}
    {PODCAST.apple && <a class="cta" href={PODCAST.apple}>Apple Podcasts</a>}
    {PODCAST.youtube && <a class="cta" href={PODCAST.youtube}>YouTube</a>}
    <a class="cta" href="/podcast.xml">RSS</a>
  </p>
  {eps.length === 0 ? <p class="muted">The first episode is on its way.</p> : (
    <ul class="list">
      {eps.map((e) => <li><a href={`/podcast/${e.id}/`}>{e.data.title}</a><span class="meta">{e.data.date.toLocaleDateString("en-US", { dateStyle: "long" })} · {e.data.duration}</span></li>)}
    </ul>
  )}
</Base>
